    },
    "registryId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'discovery-korea-storage-registry'), '2025-04-01').outputs.registryId.value]"
    },
    "privateEndpointId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'discovery-korea-private-storage'), '2025-04-01').outputs.privateEndpointId.value]"
